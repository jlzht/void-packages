# Template file for 'legcord'
pkgname=legcord
version=1.1.5
revision=1
archs="x86_64* i686*"
hostmakedepends="nodejs electron24 pnpm git"
depends="libnotify xdg-utils"
short_desc="Custom client designed to enhance Discord experience"
maintainer="jlzht <jl.zht@proton.me>"
license="custom:OSL-3.0"
homepage="https://github.com/Legcord/Legcord"
distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz"
checksum="35fe5c4ea26af3caa174795a00494a123c1272eefd94f63446a2c7cbf49050d8"
nopie=yes

do_patch() {
	sed -E \
	  -e 's#("electron"): "[^"]+",#\1: "24.3.0",#' \
	  -e 's#("electron-builder"): "[^"]+",#\1: "24.3.0",#' \
	  -i "package.json"
}

do_build() {
  NODE_ENV=development pnpm install
  NODE_ENV=production pnpm run build
  NODE_ENV=production pnpm electron-builder --linux dir --publish never -c.electronDist="/usr/lib/electron24" -c.electronVersion=24
}

do_install() {
	local _pkg="usr/lib/$pkgname"
	vmkdir $_pkg
	vmkdir usr/bin
	vcopy dist/*-unpacked/* $_pkg
	ln -sfr $DESTDIR/$_pkg/$pkgname $DESTDIR/usr/bin/armcord
}

post_install() {
	mv license.txt LICENSE
  vlicense LICENSE
}
